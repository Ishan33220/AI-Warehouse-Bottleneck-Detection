# Warehouse Operations Control Tower — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Gemini API key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your-api-key-here

# Gemini model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# n8n webhook URL (optional, for automated reporting)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/warehouse-report
