table Orders
	lineageTag: 7ca8ad16-cede-599e-9f5b-e9ca6d63ba2e

	measure 'Total Orders' = COUNTROWS(Orders)
		formatString: #,0
		displayFolder: 1 Core KPIs
		lineageTag: df93a45c-1e54-5b5e-a550-eb85edd07d1d

	measure 'Completed Orders' = CALCULATE(COUNTROWS(Orders), Orders[Order_Status] = "Delivered")
		formatString: #,0
		displayFolder: 1 Core KPIs
		lineageTag: c7776d84-f657-53b1-8aa4-0b5fa45c4471

	measure 'Delayed Orders' = CALCULATE(COUNTROWS(Orders), Orders[Delay_Status] = "Delayed")
		formatString: #,0
		displayFolder: 1 Core KPIs
		lineageTag: 24a942f8-870c-5902-a3af-63eaee2f63f3

	measure 'On Time Orders' = CALCULATE(COUNTROWS(Orders), Orders[Delay_Status] = "On Time")
		formatString: #,0
		displayFolder: 1 Core KPIs
		lineageTag: 50c953fe-8c60-5b44-84e6-c506657b1bb8

	measure 'On-Time Delivery %' = DIVIDE([On Time Orders], [On Time Orders] + [Delayed Orders])
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: 1106d318-3fe7-57d5-9dec-e43c83520be5

	measure 'Delay Rate %' = DIVIDE([Delayed Orders], [On Time Orders] + [Delayed Orders])
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: 48530bfe-6c87-5007-8c8c-c13f9ade0562

	measure 'Average Picking Time' = AVERAGE(Orders[Picking_Time_Minutes])
		formatString: #,0.0
		displayFolder: 1 Core KPIs
		lineageTag: 0fdc50c0-84b7-518c-9672-d04a8df7b3c5

	measure 'Average Packing Time' = AVERAGE(Orders[Packing_Time_Minutes])
		formatString: #,0.0
		displayFolder: 1 Core KPIs
		lineageTag: f507559e-e2aa-5855-809c-40dec76403d3

	measure 'Average Dispatch Time' = AVERAGE(Orders[Dispatch_Time_Minutes])
		formatString: #,0.0
		displayFolder: 1 Core KPIs
		lineageTag: 5159dadb-c4ef-58f3-b195-435528813b7e

	measure 'Average Delivery Hours' = DIVIDE(AVERAGE(Orders[Delivery_Time_Minutes]), 60)
		formatString: #,0.0
		displayFolder: 1 Core KPIs
		lineageTag: 9637412c-edd9-551e-b71c-5fe1baf9c9e5

	measure 'Out of Stock Orders' = CALCULATE(COUNTROWS(Orders), Orders[Inventory_Status] = "Out of Stock")
		formatString: #,0
		displayFolder: 1 Core KPIs
		lineageTag: a94b2be0-fe22-5c65-8ade-7b873b9d9933

	measure 'Low Stock Orders' = CALCULATE(COUNTROWS(Orders), Orders[Inventory_Status] = "Low Stock")
		formatString: #,0
		displayFolder: 1 Core KPIs
		lineageTag: 3f0a04ff-f9e6-5945-ad45-7bbabeff8c2e

	measure 'Inventory Shortage %' = DIVIDE([Out of Stock Orders], [Total Orders])
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: 25a5ad18-1a59-505d-8d13-050412a1b859

	measure 'Total Operational Cost' = SUM(Orders[Operational_Cost])
		formatString: \₹#,0
		displayFolder: 1 Core KPIs
		lineageTag: e7aac8e7-4004-55c1-b819-1cc4ce44ed8f

	measure 'Cost per Order' = DIVIDE([Total Operational Cost], [Total Orders])
		formatString: \₹#,0.00
		displayFolder: 2 Supporting
		lineageTag: 89a09d24-976f-5ca0-b229-16ea34cc9fa9

	measure 'Orders per Employee' =
			DIVIDE(
			    CALCULATE(COUNTROWS(Orders), Orders[Warehouse_Employee_ID] <> "Unassigned"),
			    CALCULATE(DISTINCTCOUNT(Orders[Warehouse_Employee_ID]), Orders[Warehouse_Employee_ID] <> "Unassigned")
			)
		formatString: #,0.0
		displayFolder: 2 Supporting
		lineageTag: cf6b00cf-a140-5f69-ad83-bf2626778a07

	measure 'Warehouse Delays' = CALCULATE([Delayed Orders], Orders[Delay_Stage] <> "Delivery")
		formatString: #,0
		displayFolder: 3 Bottleneck
		lineageTag: e4290152-6df1-5239-ae15-a7eb3e3237ea

	measure 'Courier Delays' = CALCULATE([Delayed Orders], Orders[Delay_Stage] = "Delivery")
		formatString: #,0
		displayFolder: 3 Bottleneck
		lineageTag: 5d387726-c1f0-5021-b4f1-e412836145ce

	measure 'Warehouse Delay Share %' = DIVIDE([Warehouse Delays], [Delayed Orders])
		formatString: 0.0%
		displayFolder: 3 Bottleneck
		lineageTag: 92653188-1d6d-5271-966a-0fe022118c65

	measure 'Biggest Warehouse Bottleneck' =
			VAR StageDelays =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED(Orders[Delay_Stage]),
			            NOT (Orders[Delay_Stage] IN {"Delivery", "No Delay", "Not Applicable"})
			        ),
			        "@Delays", CALCULATE([Delayed Orders])
			    )
			VAR TopRow = TOPN(1, StageDelays, [@Delays], DESC)
			RETURN
			    MAXX(TopRow, Orders[Delay_Stage])
		displayFolder: 3 Bottleneck
		lineageTag: 6c38a053-bc8d-50c8-83a8-f24b1309294f

	measure 'Bottleneck Delays' =
			VAR TopStage = [Biggest Warehouse Bottleneck]
			RETURN
			    CALCULATE([Delayed Orders], Orders[Delay_Stage] = TopStage)
		formatString: #,0
		displayFolder: 3 Bottleneck
		lineageTag: cb46d38a-554a-566d-a5ec-feb69c040a27

	measure 'Bottleneck Share of Delays %' = DIVIDE([Bottleneck Delays], [Delayed Orders])
		formatString: 0.0%
		displayFolder: 3 Bottleneck
		lineageTag: 467e7224-88c3-5c9b-84cc-40b048c9fed9

	measure 'Stage Bar Color' =
			VAR ThisStage = SELECTEDVALUE(Orders[Delay_Stage])
			RETURN
			    SWITCH(
			        TRUE(),
			        ThisStage = [Biggest Warehouse Bottleneck], "#D32F2F",
			        ThisStage = "Delivery", "#8A99AD",
			        "#13315C"
			    )
		displayFolder: 3 Bottleneck
		lineageTag: 05716f13-0a25-597c-b041-0e81a78957c9

	measure 'Delayed Orders (Top 8 Reasons)' =
			VAR ReasonRank =
			    RANKX(ALLSELECTED(Orders[Delay_Reason]), [Delayed Orders], , DESC, Dense)
			RETURN
			    IF(ReasonRank <= 8, [Delayed Orders])
		formatString: #,0
		displayFolder: 3 Bottleneck
		lineageTag: b61a9c17-5f96-572e-b00c-ac89d459aa82

